# Normalize text files and prefer LF across platforms.
* text=auto

# Keep Unix shell and config files LF-only.
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.env text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.md text eol=lf

# Windows-native scripts can stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
